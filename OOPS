**** ACCESS SPECIFIERS ****

1. Only public variables can be accessed outside class

class InheritanceCheck
{
    private:
        int pri_var=1;
    protected:
        int pro_var=2;
    public:
        int pub_var=3;
};

int main()
{
    InheritanceCheck inherit;
    
    cout << "Public : " << inherit.pub_var << endl;
//    cout << "Protected " << protected_var << endl;
//    cout << "Private : " << private_var << endl;
}


2. Private variable can be accessed in main() with the help of class members

class InheritanceCheckBase
{
    private:
        int pri_var=1;
    protected:
        int pro_var=2;
    public:
        int pub_var=3;
        
        int get_pro_val()
        {
            return pro_var;
        }
        int get_pri_val()
        {
            return pri_var;
        }
};

int main()
{
    InheritanceCheckBase inheritBase;
    
    cout << "Public : " << inheritBase.pub_var << endl;
    cout << "Protected " << inheritBase.get_pro_val() << endl;
    cout << "Private : " << inheritBase.get_pri_val() << endl;
    
    return 0;
}

3. Protected can be accessed in derived class

class InheritanceCheckBase
{
    private:
        int pri_var=1;
    protected:
        int pro_var=2;
    public:
        int pub_var=3;
        
        int get_pro_val()
        {
            return pro_var;
        }
        int get_pri_val()
        {
            return pri_var;
        }
};

class InheritanceCheckChild : public InheritanceCheckBase
{
    public:
        void show()
        {
            cout << "Public : " << pub_var << endl;
            cout << "Protected " << pro_var << endl;
//            cout << "Private : " << pri_var << endl;
        }
};

int main()
{
    InheritanceCheckChild inheritChild;
    
    inheritChild.show();

    return 0;
}

