**** ABSTRACTION ****


class AbstractClass
{
    virtual void performaceBonus()=0;  
};
class Employee : AbstractClass
{
    public:
        string name;
        string company;
        int age;
    
        void input()
        {
            cout << "Enter the name : ";
            cin >> name;
            cout << "Enter the name : "; 
            cin >> company;
            cout << "Enter the company name : ";
            cin >> age;
        }
        void output()
        {
            cout << "Name : " << name << endl;
            cout << "Company : " << company << endl;
            cout << "Age : " << age << endl;
        }

        Employee (string name, string company, int age)
        {
            this->name = name;
            this->company = company;
            this->age = age;
        }
        
        void performaceBonus()
        {
            cout << "Inside Employee class\n" << endl;
            if (age <=30)
                cout << "Employee age is " << age << " performaceBonus Initiated" << endl;
            else
                cout << "Employee age is " << age << " performaceBonus not Initiated" << endl;
        }
};

int main()
{
    Employee emp1("Mohan", "HCL", 30), emp2 ("Gopal", "CISCO", 31);
    emp1.output();
    emp2.output();
    
    emp1.performaceBonus();
    emp2.performaceBonus();
    
    return 0;
}


OUTPUT:
Name : Mohan
Company : HCL
Age : 30
Name : Gopal
Company : CISCO
Age : 31
Inside Employee class

Employee age is 30 performaceBonus Initiated
Inside Employee class

Employee age is 31 performaceBonus not Initiated

**** END ****

