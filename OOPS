class AbstractClass
{
    virtual void performaceBonus()=0;  
};
class Employee : AbstractClass
{
    public:
        string name;
        string company;
        int age;
    
        void output()
        {
            cout << "Name : " << name << endl;
            cout << "Company : " << company << endl;
            cout << "Age : " << age << endl;
        }

        Employee (string name, string company, int age)
        {
            this->name = name;
            this->company = company;
            this->age = age;
        }
        
        void performaceBonus()
        {
            if (age <=30)
                cout << "Employee age is " << age << " performace Bonus Initiated" << endl;
            else
                cout << "Employee age is " << age << " performace Bonus not Initiated" << endl;
        }
        
        virtual void work()
        {
            cout << name <<" is a employee" << endl;
        }
};

class Developer : public Employee
{
    private:
        string programLanguage;
    public:
        Developer(string name, string company, int age, string progLang) : Employee(name, company, age)
        {
            programLanguage = progLang;
        }
        void devOuput()
        {
            cout << name << " is using " << programLanguage << " language for fixing bugs" << endl;
        }
        void work()
        {
            cout << name <<" is a developer" << endl;
        }
    
};

class Tester : public Employee
{
    private:
        string testingSkill;
    public:
        Tester(string name, string company, int age, string skill) : Employee(name, company, age)
        {
            testingSkill = skill;
        }
        void testOuput()
        {
            cout << name << " is using " << testingSkill << " Skill for testing bugs" << endl;
        }
        void work()
        {
            cout << name <<" is a tester" << endl;
        }
    
};

int main()
{
    Developer d("Mohan", "HCL", 25, "C++");
    Employee *e1 = &d;
    d.output();
    d.devOuput();
    d.performaceBonus();
    e1->work();
    
    Tester t("Gopal", "CISCO", 31, "Python Automation");
    Employee *e2 = &t;
    t.output();
    t.testOuput();
    t.performaceBonus();
    e2->work();
   
    return 0;
}

