**** RELATIONAL OPERATOR ==, !=, >=, <= ****

class Number
{
  private:
    int val1;
    
    public:
        Number(int val)
        {
            val1 = val;
        }
        Number operator== (Number& num)
        {
            return Number(val1 == num.val1);
        }
        Number operator!= (Number& num)
        {
            return Number(val1 != num.val1);
        }
        Number operator>= (Number& num)
        {
            return Number(val1 >= num.val1);
        }
        Number operator<= (Number& num)
        {
            return Number(val1 <= num.val1);
        }   
        friend ostream& operator<<(ostream& COUT, const Number& over_ld)
        {
            COUT << over_ld.val1 << endl;
            return COUT;
        }
};

int main()
{
    Number N1(6);
    Number N2(5);
    
    Number N3 = (N1 == N2);
    cout << "== = " <<N3;
    
    Number N4 = (N1 != N2);
    cout << "!= = " <<N4;
 
    Number N5 = (N1 >= N2);
    cout << ">= = " <<N5;
    
    Number N6 = (N1 <= N2);
    cout << "<= = " <<N6;
    
     return 0;
}

OUTPUT:
======
== = 0
!= = 1
>= = 1
<= = 0

