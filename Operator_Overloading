**** BITWISE OPERATOR &, |, ! ****

class Number
{
  private:
    int val1;
    
    public:
        Number(int val)
        {
            val1 = val;
        }
        Number operator& (Number& num)
        {
            return Number(val1 & num.val1);
        }
        Number operator| (Number& num)
        {
            return Number(val1 | num.val1);
        }
        Number operator! ()
        {
            return Number(!val1);
        }
        friend ostream& operator<<(ostream& COUT, const Number& over_ld)
        {
            COUT << over_ld.val1 << endl;
            return COUT;
        }
};

int main()
{
    Number N1(6);
    Number N2(5);
    
    Number N3 = (N1& N2);
    cout << "& = " <<N3;
    
    Number N4 = (N1 | N2);
    cout << "| = " <<N4;
 
    Number N5(8); 
    !N5;
    cout << "! = " <<N5;
    
     return 0;
}

OUTPUT:
=======
& = 4
| = 7
! = 8

**** END ****


**** MEMORY MANAGEMENT OPERATOR new, delete ****

class student
{
    private:
        string name;
        int age;
    public:
        student(string name, int age)
        {
            this->name = name;
            this->age = age;
        }
        void display()
        {
            cout <<"Name = " << name << endl;
            cout <<"Age = " << age <<endl;
        }
        void * operator new(size_t size)
        {
            cout << "Overloading new operator of size " << size << endl;
            void *p = malloc(size);
            
            return p;
        }
        void operator delete(void *p)
        {
            cout << "Overloading delete operator" << endl;
            free (p);
        }
};

int main()
{
    student * s1 = new student("Mohan", 30);
    
    s1->display();
    delete s1;
    
    return 0;
}

OUTPUT:
=======
Overloading new operator of size 40
Name = Mohan
Age = 30
Overloading delete operator

